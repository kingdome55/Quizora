{
  "manifest_version": 3,
  "name": "题灵",
  "short_name": "题灵",
  "version": "0.5.6",
  "description": "题灵（Quizora）：Wayground/Quizizz、学习通与通用网页自动答题助手，整卷扫描 + 大模型判题 + 可调节奏。",
  "permissions": [
    "scripting",
    "storage",
    "tabs",
    "activeTab",
    "sidePanel",
    "webNavigation"
  ],
  "host_permissions": [
    "https://wayground.com/*",
    "https://*.quizizz.com/*",
    "https://*.chaoxing.com/*",
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.chaoxing.com/*"],
      "js": [
        "src/content/hud.js",
        "src/content/cx-debug.js",
        "src/content/cx-generic.js",
        "src/content/cx-plain.js",
        "src/content/cx-adapter.js",
        "src/content/cx-image.js",
        "src/content/cx-fill.js",
        "src/content/cx-main.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_title": "题灵",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "src/panel.html"
  }
}
